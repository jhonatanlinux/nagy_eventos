# Runtime environment: development | staging | production
VITE_APP_ENV=development

# Public Supabase client configuration. Publishable keys are safe for browser clients with RLS.
VITE_SUPABASE_URL=https://gbsaotppqslqaeueohps.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only variables. Never prefix secret keys with VITE_.
SUPABASE_URL=https://gbsaotppqslqaeueohps.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://gbsaotppqslqaeueohps.supabase.co/auth/v1/.well-known/jwks.json

# Optional build override. CI derives this value from the latest Git tag.
VITE_APP_VERSION=
