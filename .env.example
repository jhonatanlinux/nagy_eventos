# Runtime environment: development | homolog | production
VITE_APP_ENV=development

# Public Supabase client configuration. Never expose service-role keys to Vite.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Optional build override. CI derives this value from the latest Git tag.
VITE_APP_VERSION=
